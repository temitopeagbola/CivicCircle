# CivicCircle environment variables.
# Copy to .env for local development (`cp .env.example .env`). Never commit .env.
# Defaults below run everything against the local Firebase emulators with the mock AI.

# ─── API (apps/api) ─────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# Port the API listens on.
PORT=8787
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:8081,http://localhost:8080,http://localhost:19006
# Proxy hops to trust for client IPs (rate limiting). "false" locally, "1" on Render.
# "true" is rejected because clients could spoof X-Forwarded-For.
TRUST_PROXY=false

# Firebase project id. "demo-civiccircle" works with the emulators without credentials.
FIREBASE_PROJECT_ID=demo-civiccircle
# Production only: service account JSON, raw or base64-encoded (base64 -w0 key.json).
FIREBASE_SERVICE_ACCOUNT=
# Storage bucket; defaults to <project-id>.firebasestorage.app.
FIREBASE_STORAGE_BUCKET=
# Public origin for photo URLs. Defaults to the Storage emulator or firebasestorage.googleapis.com.
STORAGE_PUBLIC_URL=

# Emulator hosts. Set these to use the local Emulator Suite (`npm run emulators`);
# remove them to talk to a real Firebase project.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# AI provider: auto (OpenAI if OPENAI_API_KEY is set, else mock) | openai | mock
AI_PROVIDER=auto
# OpenAI key. Leave empty to use the free offline mock provider.
OPENAI_API_KEY=
# Chat model for classification (needs vision + JSON schema output).
OPENAI_MODEL=gpt-4.1-mini
# Embedding model for duplicate detection (requested at 256 dimensions).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Moderation model (free to call).
OPENAI_MODERATION_MODEL=omni-moderation-latest
# Hard monthly spend cap in USD. When reached, reports fall back to the mock provider.
OPENAI_MONTHLY_BUDGET_USD=5
# Optional exact prices (USD per 1M tokens) for OPENAI_MODEL; set both or neither.
# Unknown models without these are priced pessimistically so the cap stays safe.
OPENAI_PRICE_INPUT_PER_1M=
OPENAI_PRICE_OUTPUT_PER_1M=
# Send a 512px copy of the photo to the model (true/false).
OPENAI_VISION=true
# Per-call timeout in ms before falling back to the mock provider.
OPENAI_TIMEOUT_MS=20000

# One-click demo sign-in, and whether the shared demo moderator is available.
DEMO_LOGIN_ENABLED=true
DEMO_MODERATOR_ENABLED=true

# Per-IP rate limits.
RATE_LIMIT_GLOBAL_PER_15M=300
RATE_LIMIT_REPORTS_PER_HOUR=10
RATE_LIMIT_COMMENTS_PER_10M=30
RATE_LIMIT_DEMO_PER_15M=20

# ─── Web app (apps/web) ─────────────────────────────────────────────────────────
# Inlined into the bundle at build time; Expo reads them from apps/web/.env or the shell.
# Base URL of the API.
EXPO_PUBLIC_API_URL=http://localhost:8787
# Firebase web app config (Firebase console → Project settings → Your apps).
EXPO_PUBLIC_FIREBASE_API_KEY=demo-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-civiccircle.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-civiccircle
EXPO_PUBLIC_FIREBASE_APP_ID=demo-app
# Auth emulator URL for local development; leave empty in production.
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
