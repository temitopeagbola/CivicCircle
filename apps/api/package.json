{
  "name": "@civiccircle/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "seed:dist": "node dist/seed.js",
    "make-moderator": "tsx --env-file-if-exists=../../.env src/scripts/make-moderator.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:firestore": "vitest run --config vitest.emulator.config.ts",
    "start:dev": "tsx src/server.ts"
  },
  "dependencies": {
    "@civiccircle/shared": "*",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "geofire-common": "^6.0.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "openai": "^7.32.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.19.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
