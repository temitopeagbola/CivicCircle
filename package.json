{
  "name": "civiccircle",
  "private": true,
  "description": "Community issue reporting with AI triage — Expo app + Node API on Firebase.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/temitopeagbola/CivicCircle.git"
  },
  "bugs": {
    "url": "https://github.com/temitopeagbola/CivicCircle/issues"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:api": "npm run dev -w @civiccircle/api",
    "dev:web": "npm run start -w @civiccircle/web",
    "emulators": "firebase emulators:start --project demo-civiccircle --only auth,firestore,storage",
    "seed": "npm run seed -w @civiccircle/api --",
    "build:web": "npm run build -w @civiccircle/web",
    "build:api": "npm run build -w @civiccircle/api",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "test": "npm run test --workspaces --if-present",
    "test:emulator": "firebase emulators:exec --project demo-civiccircle --only auth,firestore,storage \"npm run test:firestore -w @civiccircle/api\"",
    "test:e2e": "firebase emulators:exec --project demo-civiccircle --only auth,firestore,storage \"playwright test\"",
    "build:web:e2e": "EXPO_PUBLIC_API_URL=http://localhost:8787 EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099 npm run build -w @civiccircle/web",
    "preview:web": "node e2e/serve-spa.mjs apps/web/dist 8081"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "firebase-tools": "^15.33.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
