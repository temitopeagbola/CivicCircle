{
  "name": "civiccircle",
  "private": true,
  "description": "Community issue reporting with AI triage — Expo app + Node API on Firebase.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev -w @civiccircle/api",
    "dev:web": "npm run start -w @civiccircle/web",
    "emulators": "firebase emulators:start --project demo-civiccircle --only auth,firestore,storage",
    "seed": "npm run seed -w @civiccircle/api",
    "build:web": "npm run build -w @civiccircle/web",
    "build:api": "npm run build -w @civiccircle/api",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:emulator": "firebase emulators:exec --project demo-civiccircle --only auth,firestore,storage \"npm run test:firestore -w @civiccircle/api\"",
    "test:e2e": "firebase emulators:exec --project demo-civiccircle --only auth,firestore,storage \"playwright test\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "firebase-tools": "^15.33.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
